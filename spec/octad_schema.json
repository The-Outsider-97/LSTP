{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lstp:schema:octad:0.1",
  "title": "LSTP v0.1 Canonical Packet",
  "type": "object",
  "required": [
    "id",
    "version",
    "pragmatics",
    "atoms",
    "relations",
    "context",
    "confidence",
    "permissions",
    "evidence",
    "output",
    "carrier",
    "audit"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "version": {
      "const": "0.1"
    },
    "pragmatics": {
      "$ref": "#/$defs/pragmatics"
    },
    "atoms": {
      "$ref": "#/$defs/atoms"
    },
    "relations": {
      "$ref": "#/$defs/relations"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "permissions": {
      "$ref": "#/$defs/permissions"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "carrier": {
      "type": "object"
    },
    "audit": {
      "type": "object"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?![\\s\\S])",
      "maxLength": 128
    },
    "qualifiedIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*(?![\\s\\S])",
      "maxLength": 256
    },
    "atomId": {
      "type": "string",
      "pattern": "^a(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "maxLength": 64
    },
    "relationId": {
      "type": "string",
      "pattern": "^r(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "maxLength": 64
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^e(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "maxLength": 64
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "pragmatics": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/qualifiedIdentifier"
        },
        "speech_act": {
          "$ref": "#/$defs/qualifiedIdentifier"
        },
        "goal": {
          "$ref": "#/$defs/qualifiedIdentifier"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualifiedIdentifier"
          },
          "uniqueItems": true
        },
        "register": {
          "$ref": "#/$defs/qualifiedIdentifier"
        },
        "urgency": {
          "$ref": "#/$defs/confidence"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "atom": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/atomId"
        },
        "kind": {
          "enum": [
            "entity",
            "concept",
            "value",
            "event",
            "time",
            "location",
            "resource",
            "proposition",
            "unknown"
          ]
        },
        "value": true,
        "role": {
          "$ref": "#/$defs/qualifiedIdentifier"
        },
        "datatype": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "attributes": {
          "type": "object"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "atoms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/atom"
      }
    },
    "relationArgument": {
      "oneOf": [
        {
          "$ref": "#/$defs/atomId"
        },
        {
          "enum": [
            "SELF",
            "NOW",
            "USER",
            "SYSTEM"
          ]
        }
      ]
    },
    "relation": {
      "type": "object",
      "required": [
        "type",
        "arguments"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/relationId"
        },
        "type": {
          "$ref": "#/$defs/qualifiedIdentifier"
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relationArgument"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "attributes": {
          "type": "object"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "contextReference": {
      "type": "object",
      "required": [
        "packet_id"
      ],
      "properties": {
        "packet_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "agent": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": [
        "thread_id",
        "references"
      ],
      "properties": {
        "thread_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "packet_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "parent_packet_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "conversation_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "turn": {
          "type": "integer",
          "minimum": 0
        },
        "speaker": {
          "$ref": "#/$defs/qualifiedIdentifier"
        },
        "audience": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qualifiedIdentifier"
          },
          "uniqueItems": true
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "window": true,
        "location": true,
        "bindings": {
          "type": "object"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contextReference"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/$defs/permissionMode"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        },
        "forbid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "uniqueItems": true
        },
        "require_confirmation": {
          "type": "boolean"
        },
        "require_review": {
          "type": "boolean"
        },
        "require_logging": {
          "type": "boolean"
        },
        "limits": {
          "type": "object"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "evidenceItem": {
      "type": "object",
      "required": [
        "id",
        "source_type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/evidenceId"
        },
        "source_type": {
          "enum": [
            "user",
            "sensor",
            "model",
            "tool",
            "retrieved",
            "inferred"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "input_hash": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "span": true,
        "supports": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:r(?:0|[1-9][0-9]*)|a(?:0|[1-9][0-9]*))$"
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "maxLength": 8192
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "output": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "NL",
            "LATTICE",
            "JSON",
            "YAML",
            "TABLE",
            "CODE",
            "FILE",
            "NONE"
          ]
        },
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "channel": {
          "$ref": "#/$defs/qualifiedIdentifier"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false
    },
    "permissionMode": {
      "enum": [
        "RO",
        "SUGGEST",
        "PREVIEW",
        "RW",
        "EXEC",
        "COMMIT"
      ]
    }
  }
}
